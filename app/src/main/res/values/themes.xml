<resources>
    <style name="Base.Theme.Custom" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/ui_primary</item>
        <item name="colorPrimaryVariant">@color/ui_primary_muted</item>
        <item name="colorOnPrimary">@color/ui_on_primary</item>
        <item name="colorSecondary">@color/ui_primary</item>
        <item name="colorOnSecondary">@color/ui_on_primary</item>
        <item name="colorSurface">@color/ui_surface</item>
        <item name="colorOnSurface">@color/ui_text</item>
        <item name="colorError">@color/ui_danger</item>
        <item name="colorControlNormal">@color/ui_text_secondary</item>
        <item name="colorControlActivated">@color/ui_primary</item>
        <item name="android:colorBackground">@color/ui_background</item>
        <item name="android:windowBackground">@color/ui_background</item>
        <item name="android:statusBarColor">@color/ui_background</item>
        <item name="android:navigationBarColor">@color/ui_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textColorPrimary">@color/ui_text</item>
        <item name="android:textColorSecondary">@color/ui_text_secondary</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.Custom" parent="Base.Theme.Custom" />

    <style name="Ui.Title" parent="@android:style/Widget.TextView">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:textSize">24sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Ui.SectionTitle" parent="@android:style/Widget.TextView">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Ui.Body" parent="@android:style/Widget.TextView">
        <item name="android:textColor">@color/ui_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="Ui.Caption" parent="@android:style/Widget.TextView">
        <item name="android:textColor">@color/ui_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="Ui.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/ui_primary</item>
        <item name="android:textColor">@color/ui_on_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">0dp</item>
        <item name="iconTint">@color/ui_on_primary</item>
    </style>
    <style name="Ui.SecondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/ui_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconTint">@color/ui_text</item>
    </style>
</resources>
